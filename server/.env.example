# dodo_napcat 服务器侧桥环境变量模板
# 复制为 run_dodo_bridge.env 并填写真实值（勿入库）

# NapCat OneBot 11 WebSocket（服务器本地）
NAPCAT_WS_URL=ws://127.0.0.1:6098
NAPCAT_WS_TOKEN=<your-ws-token>

# 当前 NapCat 登录的 QQ（渡渡）
BOT_QQ=<你的QQ号>

# 服务器桥鉴权 token（沿用现有值，实际值勿提交；本地部署时填真实值）
# 生成新值：python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BRIDGE_TOKEN=<your-bridge-token>

# HTTP 监听（建议仅本机，由 TLS/CF Tunnel 对外）
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8080

# 持久化目录
BRIDGE_DATA_DIR=${HOME}/.dodo_napcat

# 队列/限流（BUG-02/BUG-04）
CLAIM_TTL=300
PULL_MAX_COUNT=5
QUEUE_MAX_ITEMS=500
RATE_LIMIT_PER_MIN=30
STALE_MSG_TTL_SECONDS=300   # 需求：开启/轮询时丢弃 5 分钟前的内容
NAPCAT_KEEP_NEWEST_STALE=true  # 需求（2026-08-17）：每会话保留最近一条未处理消息（断连恢复后不丢最新一条），领取时补拉最近10条上下文
NAPCAT_GROUP_IMMEDIATE_CONTEXT=0  # 需求（2026-08-17）：群触发（@/关键词）带上下文，0=按标准at_context_count(10)，<0=关闭，>0=N条；批量观察(scope=all)始终带

# 主人（初尘）QQ 与昵称映射：苜蓿 = <主人QQ号> = 初尘（2026-08-17 显式写入 env）
NAPCAT_OWNER_QQ=<主人QQ号>
NAPCAT_OWNER_ALWAYS_REPLY=true   # 只保证「私聊」必回；群聊跟群模式走（仅艾特/关键词触发）
NAPCAT_KNOWN_USERS={"<主人QQ号>":"苜蓿"}

# 回复规则默认（2026-08-17：群默认回艾特+关键词，关键词在 Operit UI 里调）
NAPCAT_GROUP_REPLY_MODE=keyword_or_at
NAPCAT_KEYWORDS=渡渡

# 上下文
CONTEXT_TEXT_LIMIT=320